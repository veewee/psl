{
    "name": "php-standard-library/psr-7",
    "description": "PSR-7 / PSR-17 bridge over Psl\\IO",
    "license": "MIT",
    "type": "library",
    "keywords": ["psr-7", "psr-17", "http", "stream", "io"],
    "authors": [
        { "name": "Seifeddine Gmati", "email": "azjezz@carthage.software" },
        { "name": "Contributors", "homepage": "https://github.com/php-standard-library/php-standard-library/graphs/contributors" }
    ],
    "homepage": "https://php-standard-library.dev",
    "require": {
        "php": "~8.4.0 || ~8.5.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/http-factory": "^1.0",
        "php-standard-library/io": "^6.0",
        "php-standard-library/file": "^6.0",
        "php-standard-library/filesystem": "^6.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "conflict": { "azjezz/psl": "*" },
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": { "Psl\\Psr\\Http\\": "src/Psl/Psr/Http/" },
        "files": ["src/Psl/bootstrap.php"]
    },
    "autoload-dev": {
        "psr-4": { "Psl\\Psr\\Http\\Tests\\Unit\\": "tests/unit/" }
    },
    "extra": { "branch-alias": { "dev-next": "6.2.x-dev" } }
}
